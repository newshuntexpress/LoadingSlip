# All environment variables below are OPTIONAL. The app runs with built-in defaults if none are set.

# GEMINI_API_KEY: Optional (not used by GatePass & Loading Slip Manager unless AI features are added)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional runtime URL
# APP_URL="MY_APP_URL"

# SESSION_IDLE_MINUTES: Optional inactive session timeout in minutes (defaults to 30 and configurable in Plant Settings)
# SESSION_IDLE_MINUTES="30"

# ADMIN_INITIAL_PASSWORD: Optional initial password for auto-seeding the admin account on first boot
# If omitted, the app presents a secure one-time Initial Admin Setup screen on first launch.
# ADMIN_INITIAL_PASSWORD=""

